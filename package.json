{
  "name": "syncspace",
  "private": true,
  "type": "module",
  "description": "Real-time, offline-first collaborative documents (MERN + Yjs).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "db:check": "npm run db:check -w @syncspace/server",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev -w @syncspace/server\" \"npm:dev -w @syncspace/web\"",
    "build": "npm run build -w @syncspace/web",
    "start": "npm run start -w @syncspace/server",
    "seed": "npm run seed -w @syncspace/server",
    "seed:reset": "npm run seed:reset -w @syncspace/server",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check:js-only": "node scripts/check-js-only.js",
    "verify": "npm run check:js-only && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "vitest": "5.0.3"
  }
}
