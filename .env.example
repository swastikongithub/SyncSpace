# SyncSpace environment template.
# Copy to `.env` (never commit `.env`) and replace every `change-me` value.
# Generate strong values with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Use URL-safe characters (hex is easiest) because passwords are embedded in MONGODB_URI.

# ---------------------------------------------------------------------------
# Local MongoDB container (docker-compose.yml). Read by Docker Compose only.
# The root account administers the container; the backend uses the app account.
# Init scripts run only when the volume is empty: if you change these after the
# first start, run `docker compose down -v` (destroys local data) or update the
# users manually.
# ---------------------------------------------------------------------------
MONGO_ROOT_USERNAME=syncspace_root
MONGO_ROOT_PASSWORD=change-me-root-password
MONGO_APP_USERNAME=syncspace_app
MONGO_APP_PASSWORD=change-me-app-password
MONGO_APP_DB=syncspace
# Host port for the container. 27019 avoids clashing with a locally installed mongod on 27017.
MONGO_HOST_PORT=27019

# ---------------------------------------------------------------------------
# Backend (apps/server)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Any MongoDB connection string works, including MongoDB Atlas (mongodb+srv://...).
# For the local container the password must match MONGO_APP_PASSWORD above.
MONGODB_URI=mongodb://syncspace_app:change-me-app-password@127.0.0.1:27019/syncspace?authSource=syncspace
# Comma-separated list of browser origins allowed to call the API and open WebSockets.
APP_ORIGINS=http://localhost:5173
# Session lifetime and idle timeout.
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=72
# Cookies are Secure by default in production. Only set to false for plain-HTTP local testing.
# COOKIE_SECURE=false
# Set when running behind a reverse proxy / load balancer (e.g. 1 for a single proxy hop).
# TRUST_PROXY=1
LOG_LEVEL=info
# Sign-in attempts per 15 minutes per address+account, and registrations per hour per address.
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_REGISTER=20
# Startup connection retry policy (exponential backoff, capped at 10s between attempts).
DB_CONNECT_MAX_ATTEMPTS=10
DB_CONNECT_RETRY_MS=500
